# --- Apify -------------------------------------------------------------------
# Apify Console → Settings → API & Integrations → Personal API token
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxx

# --- OpenAI ------------------------------------------------------------------
# platform.openai.com → API keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-5-mini
# Reasoning depth: minimal | low | medium | high. Reasoning tokens are billed as
# output tokens, so this is the main cost/quality dial.
OPENAI_REASONING_EFFORT=medium

# --- Typeform ----------------------------------------------------------------
# You invent this string, then paste it into the Typeform webhook "Secret" field.
# Anything long and random: `openssl rand -hex 32`
TYPEFORM_WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- Google Sheets -----------------------------------------------------------
# base64 of the service account JSON key file:
#   base64 -i service-account.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_B64=
# From the sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads

# --- Behaviour ---------------------------------------------------------------
# Skip HMAC verification for local testing. NEVER set true in production.
ALLOW_UNSIGNED_WEBHOOKS=false
